{
  "expo": {
    "name": "روعي",
    "slug": "roi",
    "scheme": "roi",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.increasinglabs.roi",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleLocalizations": [
          "ar"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.increasinglabs.roi",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FEEAC9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@rnrepo/expo-config-plugin",
      "./plugins/with-firebase-configure",
      "./plugins/with-utf8-pods",
      "./plugins/with-xcode27-devlauncher",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Amiri-Regular.ttf",
            "./assets/fonts/Amiri-Bold.ttf",
            "./assets/fonts/ScheherazadeNew-Regular.ttf",
            "./assets/fonts/ScheherazadeNew-Bold.ttf",
            "./assets/fonts/IBMPlexSansArabic-Regular.ttf",
            "./assets/fonts/IBMPlexSansArabic-Medium.ttf",
            "./assets/fonts/IBMPlexSansArabic-Bold.ttf"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosDependencyManager": "cocoapods",
          "iosUrlScheme": "com.googleusercontent.apps.23662840492-laqcbt3hkft72a3mu0ofcokeskr7sr7a"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.increasinglabs.roi",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "RoiSpike",
              "displayName": "روعي",
              "description": "روعي",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Amiri-Regular.ttf",
            "./assets/fonts/IBMPlexSansArabic-Regular.ttf"
          ],
          "widgets": [
            {
              "name": "RoiSpike",
              "label": "روعي",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
